# Sentinel 2 backend environment example

# Auth mode: `eve` (EVE OAuth) or `testauth` (TestAuth)
AUTH_BACKEND=eve

# Public application origin used for OAuth callbacks and post-login redirects.
# Required outside local development; production must use https.
# PUBLIC_BASE_URL=https://app.example.com

# TestAuth client credentials (required when AUTH_BACKEND=testauth)
# TESTAUTH_URL should point at the TestAuth provider base URL that serves /.well-known/oauth-authorization-server
TESTAUTH_URL=
TESTAUTH_CLIENT_ID=
TESTAUTH_CLIENT_SECRET=

# TestAuth scopes (comma-delimited, defaults to profile,groups,permissions)
TESTAUTH_SCOPES=profile,groups,permissions

# TestAuth access mappings (comma-delimited)
TESTAUTH_ADMIN_GROUPS=
TESTAUTH_STAFF_GROUPS=
TESTAUTH_ADMIN_PERMISSION_URNS=
STAFF_PERMISSION_URNS=

# EVE SSO application credentials (required when AUTH_BACKEND=eve)
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=

# EVE OAuth endpoints and scopes
EVE_AUTH_URL=https://login.eveonline.com/v2/oauth/authorize
EVE_TOKEN_URL=https://login.eveonline.com/v2/oauth/token
EVE_SCOPES=esi-location.read_location.v1 esi-ui.write_waypoint.v1

# ESI endpoint for direct EVE mode
ESI_DIRECT_BASE_URL=https://esi.evetech.net/latest/

# Default map region IDs (comma/semicolon/plus separated)
DEFAULT_MAP_REGIONS=10000029

# Optional: number of dedupe slots per report fingerprint (default: 20)
# INTEL_REPORT_HASH_SLOTS=20

# Optional: disable timer board APIs/UI and timer sync jobs
# TIMERS_ENABLED=false

# Optional: ingest zKillboard feed sequence into intel reports
# ZKILL_FEED_ENABLED=true
# ZKILL_FEED_BASE_URL=https://r2z2.zkillboard.com/ephemeral
# ZKILL_FEED_POLL_SECONDS=10
# ZKILL_MAX_EVENT_AGE_SECONDS=300

# Optional: backend proxy target used in local dev mode
# DEV_PROXY=127.0.0.1:5173

# Optional: enable verbose debug logging (prints SQL + debug logs)
# DEBUG_ENABLED=true

# Optional: logging controls
# LOG_LEVEL=info                # one of: debug|info|warn|error
# LOG_PRETTY=true               # styled console output for sentinel app logs
# LOG_PRETTY_PB=true            # styled PocketBase request/db logs (experimental)
# LOG_JSON=true                 # write sentinel app logs to JSONL
# LOG_JSON_PATH=/tmp/sentinel2-dev/backend.jsonl  # JSONL output path
# LOG_JSON_PB=true              # also write PocketBase request/db logs to JSONL (experimental)

# Optional: Cloudflare Tunnel token used by docker-compose.tunnel.yml
# CF_TUNNEL_TOKEN=
