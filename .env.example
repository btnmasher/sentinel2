# Sentinel 2 (EVE auth) example environment

# Auth mode: "eve" for EVE OAuth
AUTH_BACKEND=eve

# EVE SSO application credentials (from the EVE developer portal)
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=

# OAuth endpoints (defaults are fine for most setups)
EVE_AUTH_URL=https://login.eveonline.com/v2/oauth/authorize
EVE_TOKEN_URL=https://login.eveonline.com/v2/oauth/token
EVE_VERIFY_URL=https://login.eveonline.com/oauth/verify

# EVE OAuth scopes (space-delimited)
EVE_SCOPES=esi-location.read_location.v1 esi-ui.write_waypoint.v1

# Session keys (set these to long random strings)
SESSION_AUTH_KEY=change-me
SESSION_ENC_KEY=change-me

# ESI configuration
ESI_BACKEND=proxy
ESI_BASE_URL=https://auth.pleaseignore.com/esi/
ESI_DIRECT_BASE_URL=https://esi.evetech.net/latest/

# Optional: version label used in the UI/footer
SENTINEL_VERSION=2.0.1

# Optional: disable auto SDE updates by setting to false
# AUTO_SDE_UPDATE=true


# Optional: enable verbose debug logging (prints SQL + debug logs)
# DEBUG_ENABLED=true

# Optional: logging controls
# LOG_LEVEL=info
# LOG_PRETTY=true
# LOG_PRETTY_PB=true
# LOG_JSON=true
# LOG_JSON_PATH=/tmp/sentinel2-dev/backend.jsonl
# LOG_JSON_PB=true
