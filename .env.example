# Sentinel 2 backend environment example

# Auth mode: `eve` (EVE OAuth) or `testauth` (OIDC)
AUTH_BACKEND=eve

# OIDC client credentials (required when AUTH_BACKEND=testauth)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# OIDC scopes (space-delimited)
OIDC_SCOPES=openid

# OIDC role lists (comma-delimited)
OIDC_REQUIRED_ROLES=urn:sso:alliance:test-alliance,urn:sso:allies
OIDC_STAFF_ROLES=urn:sso:staff_user

# OIDC endpoints (defaults are fine for most setups)
OIDC_ISSUER=https://sso.pleaseignore.com/auth/realms/auth-ng
OIDC_AUTH_URL=https://sso.pleaseignore.com/auth/realms/auth-ng/protocol/openid-connect/auth
OIDC_TOKEN_URL=https://sso.pleaseignore.com/auth/realms/auth-ng/protocol/openid-connect/token
OIDC_USERINFO_URL=https://sso.pleaseignore.com/auth/realms/auth-ng/protocol/openid-connect/userinfo
OIDC_PORTAL_URL=https://auth.pleaseignore.com

# EVE SSO application credentials (required when AUTH_BACKEND=eve)
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=

# EVE OAuth endpoints and scopes
EVE_AUTH_URL=https://login.eveonline.com/v2/oauth/authorize
EVE_TOKEN_URL=https://login.eveonline.com/v2/oauth/token
EVE_SCOPES=esi-location.read_location.v1 esi-ui.write_waypoint.v1

# ESI endpoints (direct ESI and optional alliance proxy)
ESI_DIRECT_BASE_URL=https://esi.evetech.net/latest/
ESI_PROXY_BASE_URL=https://auth.pleaseignore.com/esi/

# Default map region IDs (comma/semicolon/plus separated)
DEFAULT_MAP_REGIONS=10000029

# Optional: number of dedupe slots per report fingerprint (default: 20)
# INTEL_REPORT_HASH_SLOTS=20

# Optional: backend proxy target used in local dev mode
# DEV_PROXY=127.0.0.1:5173

# Optional: enable verbose debug logging (prints SQL + debug logs)
# DEBUG_ENABLED=true

# Optional: logging controls
# LOG_LEVEL=info                # one of: debug|info|warn|error
# LOG_PRETTY=true               # styled console output for sentinel app logs
# LOG_PRETTY_PB=true            # styled PocketBase request/db logs (experimental)
# LOG_JSON=true                 # write sentinel app logs to JSONL
# LOG_JSON_PATH=/tmp/sentinel2-dev/backend.jsonl  # JSONL output path
# LOG_JSON_PB=true              # also write PocketBase request/db logs to JSONL (experimental)
